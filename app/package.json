{
  "name": "sojourn",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "build": "npm run check && vite build && npm run check:dist",
    "preview": "vite preview",
    "deploy": "npm run build && npm run verify:china && wrangler pages deploy dist --project-name=sojourn",
    "seed-build": "tsx scripts/build-china-seed.ts",
    "icons": "tsx scripts/make-icons.ts",
    "check:dist": "tsx scripts/check-dist-clean.ts",
    "verify:china": "tsx scripts/verify-china-parity.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.0",
    "@fontsource-variable/instrument-sans": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "dexie": "^4.2.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^26.1.1",
    "fake-indexeddb": "^6.0.0",
    "sharp": "^0.34.0",
    "svelte": "^5.35.0",
    "svelte-check": "^4.2.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}

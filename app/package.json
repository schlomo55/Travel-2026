{
  "name": "livingthedream",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "build": "npm run check && npm run check:contrast && vite build && npm run check:dist && npm run check:bundle",
    "preview": "vite preview",
    "deploy": "npm run build && npm run verify:china && wrangler pages deploy dist --project-name=living-the-dream",
    "seed-build": "tsx scripts/build-china-seed.ts",
    "seed-build:israel": "tsx scripts/build-israel-test-seed.ts",
    "seed-build:template-example": "tsx scripts/build-template-example-seed.ts",
    "icons": "tsx scripts/make-icons.ts",
    "check:dist": "tsx scripts/check-dist-clean.ts",
    "verify:china": "tsx scripts/verify-china-parity.ts",
    "verify:places": "tsx scripts/verify-place-names.ts",
    "photos:fetch": "tsx scripts/fetch-photos.ts",
    "rehearsal": "node scripts/e2e/rehearsal.mjs",
    "android:assets": "tsx scripts/make-android-assets.ts && capacitor-assets generate --android --iconBackgroundColor \"#000000\" --iconBackgroundColorDark \"#000000\" --splashBackgroundColor \"#0B0C16\" --splashBackgroundColorDark \"#0B0C16\"",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run build && cap sync android && cd android && gradlew.bat assembleRelease",
    "android:install": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "map:pack": "tsx scripts/maps/build-pack.ts",
    "map:declination": "tsx scripts/maps/declination.ts"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/app-launcher": "^7.0.4",
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@protomaps/basemaps": "5.7.2",
    "dexie": "^4.2.0",
    "maplibre-gl": "6.11.2",
    "maplibre-gl-v5": "npm:maplibre-gl@5.24.0",
    "pmtiles": "4.5.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.8",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^26.1.1",
    "fake-indexeddb": "^6.0.0",
    "magvar": "2.2.0",
    "sharp": "^0.34.5",
    "svelte": "^5.35.0",
    "svelte-check": "^4.2.0",
    "terser": "^5.49.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}

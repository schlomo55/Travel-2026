{
  "name": "livingthedream",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "build": "npm run check && npm run check:contrast && vite build && npm run check:dist",
    "preview": "vite preview",
    "deploy": "npm run build && npm run verify:china && wrangler pages deploy dist --project-name=living-the-dream",
    "seed-build": "tsx scripts/build-china-seed.ts",
    "seed-build:israel": "tsx scripts/build-israel-test-seed.ts",
    "icons": "tsx scripts/make-icons.ts",
    "check:dist": "tsx scripts/check-dist-clean.ts",
    "verify:china": "tsx scripts/verify-china-parity.ts",
    "verify:places": "tsx scripts/verify-place-names.ts",
    "photos:fetch": "tsx scripts/fetch-photos.ts",
    "rehearsal": "node scripts/e2e/rehearsal.mjs",
    "android:assets": "tsx scripts/make-android-assets.ts && capacitor-assets generate --android --iconBackgroundColor \"#000000\" --iconBackgroundColorDark \"#000000\" --splashBackgroundColor \"#000000\" --splashBackgroundColorDark \"#000000\"",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run build && cap sync android && cd android && gradlew.bat assembleRelease",
    "android:install": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@capacitor/app-launcher": "^7.0.4",
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/share": "^7.0.4",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.2.0",
    "@fontsource-variable/instrument-sans": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/special-elite": "^5.3.0",
    "dexie": "^4.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.8",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^26.1.1",
    "fake-indexeddb": "^6.0.0",
    "sharp": "^0.34.5",
    "svelte": "^5.35.0",
    "svelte-check": "^4.2.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}

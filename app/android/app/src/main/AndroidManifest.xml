<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Google Drive backup (opt-in). Google refuses OAuth inside a
                WebView, so consent happens in the system browser and comes
                back here through this custom scheme — the installed-app PKCE
                redirect, which carries an authorization code and no secret.
                The scheme must equal the applicationId and must match
                driveConfig.ts's redirectScheme. launchMode is already
                singleTask above, so the answer lands in the running app
                rather than a second copy of it.

                Delivering the URL into the WebView is the one step this run
                could not finish (it needs a native build) — see
                docs/DRIVE-SETUP.md §5. Until then this filter is harmless:
                nothing else on the phone emits this scheme.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.livingthedream.travel" />
            </intent-filter>

            <!-- Long-press shortcuts on the launcher icon (the Reminders run):
                 Now, Wallet, Map, To do. The file is GENERATED by build.gradle
                 (ltdShortcuts) so each shortcut targets the app actually being
                 built: LTD Horizon today, the real LTD after the switch. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/ltd_shortcuts" />
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!--
        Android 11+ package visibility. Without these, AppLauncher.canOpenUrl()
        always answers false and the Amap button silently degrades to its web
        page even when Amap is installed on the phone. Declaring the schemes we
        actually launch is the whole list — no broad QUERY_ALL_PACKAGES.
    -->
    <queries>
        <!-- Amap / 高德地图 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="androidamap" />
        </intent>
        <package android:name="com.autonavi.minimap" />
        <!-- anything that can show a geo: point or an https map link -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        The Map tab's "you are here" (Map 5c). The WebView relays the page's
        navigator.geolocation request to Android through Capacitor's
        BridgeWebChromeClient, which asks for these two — and asks only when
        the owner first taps "Show where you are" on the map, never at launch.
        FINE is the dot on the street; COARSE is what Android offers when the
        owner picks "approximate" (the map then says how rough, and shows no
        distance it cannot stand behind). GPS needs no network.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Reminders (the Reminders run). The notifications plugin brings
         POST_NOTIFICATIONS and RECEIVE_BOOT_COMPLETED itself (its merged
         manifest); on-time ringing needs "Alarms & reminders" on Android 12,
         which the owner grants from Settings -> Reminders. Without it a
         reminder still rings, inside Android's own window. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- Android 13+: exact alarms without a trip to Settings. Google Play limits
         this permission to alarm and calendar apps; LTD is installed from the
         owner's own Drive, never through Play. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
</manifest>
